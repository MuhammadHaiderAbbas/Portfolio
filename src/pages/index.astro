---
import Base from '../layouts/Base.astro';
import ItemCard from '../components/ItemCard.astro';
import { getContent, md, formatDate, formatPrice } from '../lib/content';
import { url } from '../lib/paths';
import { iconSvg } from '../lib/icons';
import { isOn } from '../lib/site-text';

const { profile, projects, services, posts, stats, focus, skills, timeline, text: t } = await getContent();
const featuredAll = projects.filter((p) => p.featured);
const featured = (featuredAll.length ? featuredAll : projects).slice(0, 3);
const categories = new Set(projects.map((p) => p.category));
const disciplines = profile.disciplines.filter((d) => !d.category || categories.has(d.category));
const roles = (profile.roles ?? []).filter(Boolean);
const rotate = isOn(t, 'effects.roles') && roles.length > 1;
const show3d = isOn(t, 'bg3d.enabled');
// Name with the last word set in italic, editorial style
const nameWords = profile.name.trim().split(/\s+/);
const nameLast = nameWords.length > 1 ? nameWords.pop() : '';
const nameFirst = nameWords.join(' ');
// Tools strip: every skill name once
const tools = [...new Set(skills.map((s) => s.name).filter(Boolean))];
// Snapshot numbers count up from zero when they come into view
const countable = (v: string) => {
  const m = String(v).match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/);
  return m ? { prefix: m[1], n: m[2], suffix: m[3] } : null;
};
const work = timeline.filter((x) => x.kind === 'work').slice(0, 3);
const study = timeline.filter((x) => x.kind === 'education').slice(0, 1);
const journey = [...study, ...work];
const [lead, ...rest] = featured;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: new URL(url('/'), Astro.site).href,
  jobTitle: roles[0],
  email: profile.email ? `mailto:${profile.email}` : undefined,
  image: profile.photo_url ? new URL(url(profile.photo_url), Astro.site).href : undefined,
  address: profile.location ? { '@type': 'PostalAddress', addressLocality: profile.location } : undefined,
  sameAs: profile.socials.map((s) => s.url),
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="band hero-band">
    {show3d && <canvas class="scene" data-density={t['bg3d.density']} data-anchor=".photo" aria-hidden="true"></canvas>}
    <div class="wrap hero">
      {profile.photo_url && (
        <div class="photo" data-tilt="10">
          <div class="ring" aria-hidden="true"></div>
          <img src={url(profile.photo_url)} alt={`Portrait of ${profile.name}`} width="720" height="720" fetchpriority="high" />
          {profile.location && <span class="photo-tag" aria-hidden="true"><span class="dot"></span>{profile.location.split(',')[0]}</span>}
        </div>
      )}
      <div class="hero-text">
        <p class="kicker">
          <span class="rule" aria-hidden="true"></span>
          {t['home.kicker']}
        </p>
        <h1 class="hero-name">
          {nameFirst} {nameLast && <em>{nameLast}</em>}
        </h1>
        {roles.length > 0 && (
          <p class="roles" data-roles={rotate ? '' : undefined} aria-label={roles.join(', ')}>
            {(rotate ? roles : roles.slice(0, 1)).map((r, i) => <span class={i === 0 ? 'on' : ''} aria-hidden="true">{r}</span>)}
          </p>
        )}
        {profile.headline && <p class="headline">{profile.headline}</p>}
        <p class="intro">{profile.intro}</p>
        <div class="actions">
          {profile.cv_url && (
            <a class="btn" href={url(profile.cv_url)} download>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"></path></svg>
              {t['home.cta_cv']}
            </a>
          )}
          <a class="btn btn-ghost" href={url('/projects/')}>{t['home.cta_primary']}</a>
        </div>
        {profile.availability && (
          <p class="availability"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
        )}
      </div>
    </div>
    <a class="scroll-cue" href="#next" aria-label={t['home.scroll']}><span aria-hidden="true"></span></a>
  </section>

  <div id="next"></div>
  {isOn(t, 'home.show_stats') && stats.length > 0 && (
    <section class="wrap stats-wrap">
      <h2 class="visually-hidden">{t['home.stats_title']}</h2>
      <ul class="stats">
        {stats.map((s, i) => {
          const c = countable(s.value);
          return (
            <li class="card" data-tilt="10" data-reveal style={`--d:${i * 80}ms`}>
              <span class="icon-tile" set:html={iconSvg(s.icon)} />
              <span class="stat-value">
                {c ? <>{c.prefix}<span data-count={c.n}>{c.n}</span>{c.suffix}</> : s.value}
              </span>
              <span class="stat-label">{s.label}</span>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {isOn(t, 'home.show_marquee') && tools.length > 4 && (
    <section class="marquee" aria-label={t['home.marquee_title']}>
      <ul class="marquee-track">
        {[0, 1].map((copy) =>
          tools.map((name) => <li aria-hidden={copy ? 'true' : undefined}>{name}</li>)
        )}
      </ul>
    </section>
  )}

  {isOn(t, 'home.show_about') && profile.about && (
    <section class="wrap section">
      <div class="about-grid">
        <div data-reveal>
          <h2 class="eyebrow">{t['home.about_title']}</h2>
          <div class="prose about-prose" set:html={md(profile.about)} />
        </div>
        {disciplines.length > 0 && (
          <aside class="about-side" data-reveal style="--d:120ms">
            <p class="eyebrow">{t['home.disciplines_title']}</p>
            <ul class="disciplines" aria-label="Browse projects by discipline">
              {disciplines.map((d) => (
                <li>
                  <a href={url(d.category ? `/projects/?c=${encodeURIComponent(d.category)}` : '/projects/')}>
                    {d.label}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </section>
  )}

  {isOn(t, 'home.show_focus') && focus.length > 0 && (
    <section class="section-alt">
      <div class="wrap">
        <div class="title"><h2>{t['home.focus_title']}</h2></div>
        <ol class="focus">
          {focus.map((f, i) => (
            <li data-reveal style={`--d:${(i % 2) * 90}ms`}>
              <span class="focus-num" aria-hidden="true">{pad(i)}</span>
              <div>
                <h3><span class="focus-ico" set:html={iconSvg(f.icon)} />{f.title}</h3>
                <p>{f.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {isOn(t, 'home.show_featured') && lead && (
    <section class="wrap section">
      <div class="title">
        <h2>{t['home.featured_title']}</h2>
        <a href={url('/projects/')}>{t['home.featured_all']}</a>
      </div>
      <div class="showcase">
        <a class="show-lead card" href={url(`/projects/${lead.slug}/`)} data-reveal>
          <div class="show-media">
            {lead.cover_url && <img src={url(lead.cover_url)} alt="" width="1200" height="675" loading="lazy" decoding="async" />}
          </div>
          <div class="show-body">
            <p class="kick">{lead.category}{lead.year && ` · ${lead.year}`}</p>
            <h3>{lead.title}</h3>
            <p>{lead.summary}</p>
            <span class="more">View the case study →</span>
          </div>
        </a>
        <div class="show-rest">
          {rest.map((p, i) => (
            <a class="show-item card" href={url(`/projects/${p.slug}/`)} data-reveal style={`--d:${(i + 1) * 100}ms`}>
              <div class="show-media">
                {p.cover_url && <img src={url(p.cover_url)} alt="" width="800" height="450" loading="lazy" decoding="async" />}
              </div>
              <div class="show-body">
                <p class="kick">{p.category}{p.year && ` · ${p.year}`}</p>
                <h3>{p.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {isOn(t, 'home.show_timeline') && journey.length > 0 && (
    <section class="section-alt">
      <div class="wrap">
        <div class="title">
          <h2>{t['home.timeline_title']}</h2>
          <a href={url('/resume/')}>{t['home.timeline_link']}</a>
        </div>
        <ol class="journey">
          {journey.map((j, i) => (
            <li data-reveal style={`--d:${i * 90}ms`}>
              <span class="j-dot" aria-hidden="true"></span>
              <p class="j-period">{j.period}</p>
              <h3>{j.title}</h3>
              <p class="j-org">{j.organisation}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {isOn(t, 'home.show_services') && services.length > 0 && (
    <section class="wrap section">
      <div class="title">
        <h2>{t['home.services_title']}</h2>
        <a href={url('/services/')}>{t['services.view']}</a>
      </div>
      <ul class="pricing">
        {services.map((s, i) => (
          <li class:list={['card', 'package', { highlight: s.highlighted }]} data-tilt="8" data-reveal style={`--d:${i * 80}ms`}>
            {s.highlighted && <span class="badge-top">{t['home.services_popular']}</span>}
            {s.icon && <span class="icon-tile" set:html={iconSvg(s.icon)} />}
            <h3>{s.title}</h3>
            {s.price_label && (
              <p class="price">
                {formatPrice(s.price_label, t['services.currency'])}
                {s.price_note && <small>{s.price_note}</small>}
              </p>
            )}
            {(s.tagline || s.description) && <p class="pkg-desc">{s.tagline || s.description}</p>}
            {s.features.length > 0 && (
              <ul>
                {s.features.map((f) => <li>{f}</li>)}
              </ul>
            )}
            <a class={s.highlighted ? 'btn' : 'btn btn-ghost'} href={url(s.slug ? `/services/${s.slug}/` : '/contact/')}>
              {s.slug ? t['services.view'] : t['home.services_button']}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {isOn(t, 'home.show_posts') && posts.length > 0 && (
    <section class="wrap section">
      <div class="title">
        <h2>{t['home.posts_title']}</h2>
        <a href={url('/blog/')}>{t['home.posts_all']}</a>
      </div>
      <ul class="items">
        {posts.slice(0, 3).map((p) => (
          <ItemCard href={`/blog/${p.slug}/`} image={p.cover_url} kicker={p.tags[0]} title={p.title} text={p.excerpt} meta={[formatDate(p.published_on)]} />
        ))}
      </ul>
    </section>
  )}

  {isOn(t, 'home.show_cta') && (
    <section class="wrap section">
      <div class="band cta" data-reveal>
        <div>
          <h2>{t['home.cta_title']}</h2>
          <p class="muted">{t['home.cta_text']}</p>
        </div>
        <div class="actions">
          <a class="btn cta-btn" href={url('/contact/')}>{t['home.cta_button']}</a>
          {isOn(t, 'hire.show') && <a class="btn btn-ghost" href={url('/hire/')}>{t['nav.hire']}</a>}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero-band {
    min-height: min(46rem, calc(100svh - var(--header-h)));
    display: flex;
    align-items: center;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(5rem, 9vw, 7rem);
  }
  .photo {
    position: relative;
    aspect-ratio: 1;
    width: min(100%, 22rem);
    justify-self: center;
    border-radius: 50%;
    padding: 0.85rem;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.3s ease;
  }
  /* The thick ring of the original theme, with a slowly turning light */
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from var(--spin, 0deg), #7cc2ff, rgba(255, 255, 255, 0.15) 30%, #2b3a52 55%, var(--accent) 80%, #7cc2ff);
    box-shadow: 0 25px 60px -20px rgba(0, 0, 0, 0.6);
    animation: spin 9s linear infinite;
  }
  @property --spin {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes spin {
    to {
      --spin: 360deg;
    }
  }
  .photo img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid #0a1d3d;
    transform: translateZ(30px);
  }
  .roles {
    position: relative;
    height: 1.7em;
    margin: 0 0 0.5rem;
    color: var(--band-muted);
    font-weight: 500;
    overflow: hidden;
  }
  .roles span {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(0.6em);
    transition: opacity 0.5s ease, transform 0.5s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .roles span.on {
    opacity: 1;
    transform: none;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 1.4rem + 5.2vw, 5.4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-bottom: 0.3em;
  }
  .hero h1 em {
    display: inline-block;
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(100deg, #fff 10%, #9fd2ff 55%, #fff 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.06em;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--band-muted);
  }
  .kicker .rule {
    inline-size: 2.5rem;
    block-size: 1px;
    background: currentColor;
  }
  .photo-tag {
    position: absolute;
    right: -0.5rem;
    bottom: 12%;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(4, 22, 51, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.25);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.85rem;
    transform: translateZ(60px);
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 4.6rem;
    translate: -50% 0;
    inline-size: 1.6rem;
    block-size: 2.6rem;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    z-index: 1;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 0.45rem;
    inline-size: 4px;
    block-size: 0.55rem;
    margin-left: -2px;
    border-radius: 2px;
    background: #fff;
    animation: cue 1.8s ease-in-out infinite;
  }
  @keyframes cue {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(0.9rem); opacity: 0; }
    100% { opacity: 0; }
  }
  @media (max-width: 48rem), (max-height: 40rem) {
    .scroll-cue { display: none; }
  }
  .headline {
    font-size: var(--step-1);
    font-weight: 500;
  }
  .intro {
    color: var(--band-muted);
    max-width: 38rem;
  }
  .availability {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.95rem;
    font-style: italic;
    margin: 1.4rem 0 0;
    color: var(--band-muted);
  }
  .dot {
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: #4ad48c;
    box-shadow: 0 0 0 4px rgba(74, 212, 140, 0.25);
  }
  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding-bottom: 5.5rem;
    }
    .photo {
      width: min(68%, 15rem);
    }
    .intro {
      margin-inline: auto;
    }
    .availability,
    .kicker,
    .hero .actions {
      justify-content: center;
    }
    .photo-tag {
      right: 0;
    }
    .kicker .rule {
      display: none;
    }
    .stats-wrap .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .stats-wrap .stats li {
      padding: 1rem 0.5rem;
    }
    .availability {
      text-align: left;
      max-width: 22rem;
      margin-inline: auto;
    }
    .roles {
      height: 3.4em;
    }
    .roles span {
      white-space: normal;
    }
  }

  /* Snapshot cards overlap the bottom of the blue band */
  .stats-wrap {
    position: relative;
    z-index: 2;
    margin-top: -3.5rem;
  }
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
  }
  .stats li {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 1.3rem 1rem 1.2rem;
    text-align: center;
  }
  .stat-value {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: 0.4rem;
  }
  .stat-label {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: start;
  }
  @media (max-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  /* Moving strip of tools */
  .marquee {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: 1.1rem;
    border-block: 1px solid var(--line);
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee li {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    padding-right: 2.25rem;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.7rem);
    font-style: italic;
    color: var(--muted);
    white-space: nowrap;
  }
  .marquee li::after {
    content: '✦';
    font-style: normal;
    font-size: 0.6em;
    color: var(--accent-text);
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask: none; mask: none; }
    .marquee-track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; padding-inline: var(--gutter); }
    .marquee li { font-size: 1.1rem; }
    .marquee li[aria-hidden='true'] { display: none; }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    font-weight: 400;
    line-height: 1.4;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .eyebrow::before {
    content: '';
    inline-size: 2rem;
    block-size: 1px;
    background: currentColor;
  }
  .about-prose > :global(p:first-child) {
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.75rem);
    line-height: 1.45;
    color: var(--ink);
  }
  .about-prose :global(blockquote) {
    font-style: italic;
  }
  .about-side {
    padding-top: 0.25rem;
  }
  .disciplines {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .disciplines a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 0.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.1rem;
    transition: padding 0.25s ease, color 0.25s ease;
  }
  .disciplines a:hover {
    color: var(--accent-text);
    padding-left: 0.75rem;
    text-decoration: none;
  }
  .disciplines svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    flex: none;
    transition: transform 0.25s ease;
  }
  .disciplines a:hover svg {
    transform: translate(2px, -2px);
  }

  /* What I do: numbered, editorial */
  .focus {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: 0 3rem;
  }
  .focus li {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }
  .focus-num {
    font-size: 2.6rem;
    line-height: 1;
    font-style: italic;
    color: var(--accent-text);
    opacity: 0.85;
  }
  .focus h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
    font-size: 1.3rem;
  }
  .focus-ico {
    display: inline-flex;
    color: var(--accent-text);
