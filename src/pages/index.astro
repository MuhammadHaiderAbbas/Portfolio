---
import Base from '../layouts/Base.astro';
import ItemCard from '../components/ItemCard.astro';
import { getContent, md, formatDate, formatPrice } from '../lib/content';
import { url } from '../lib/paths';
import { iconSvg } from '../lib/icons';
import { isOn } from '../lib/site-text';

const { profile, projects, services, posts, stats, focus, text: t } = await getContent();
const featuredAll = projects.filter((p) => p.featured);
const featured = (featuredAll.length ? featuredAll : projects).slice(0, 3);
const categories = new Set(projects.map((p) => p.category));
const disciplines = profile.disciplines.filter((d) => !d.category || categories.has(d.category));
const roles = (profile.roles ?? []).filter(Boolean);
const rotate = isOn(t, 'effects.roles') && roles.length > 1;
const show3d = isOn(t, 'bg3d.enabled');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: new URL(url('/'), Astro.site).href,
  jobTitle: roles[0],
  email: profile.email ? `mailto:${profile.email}` : undefined,
  image: profile.photo_url ? new URL(url(profile.photo_url), Astro.site).href : undefined,
  address: profile.location ? { '@type': 'PostalAddress', addressLocality: profile.location } : undefined,
  sameAs: profile.socials.map((s) => s.url),
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="band hero-band">
    {show3d && <canvas class="scene" data-density={t['bg3d.density']} data-anchor=".photo" aria-hidden="true"></canvas>}
    <div class="wrap hero">
      {profile.photo_url && (
        <div class="photo" data-tilt="10">
          <div class="ring" aria-hidden="true"></div>
          <img src={url(profile.photo_url)} alt={`Portrait of ${profile.name}`} width="720" height="720" fetchpriority="high" />
        </div>
      )}
      <div class="hero-text">
        {roles.length > 0 && (
          <p class="roles" data-roles={rotate ? '' : undefined} aria-label={roles.join(', ')}>
            {(rotate ? roles : roles.slice(0, 1)).map((r, i) => <span class={i === 0 ? 'on' : ''} aria-hidden="true">{r}</span>)}
          </p>
        )}
        <h1>{profile.name}</h1>
        {profile.headline && <p class="headline">{profile.headline}</p>}
        <p class="intro">{profile.intro}</p>
        {profile.availability && (
          <p class="availability"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
        )}
        <div class="actions">
          {profile.cv_url && (
            <a class="btn" href={url(profile.cv_url)} download>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"></path></svg>
              {t['home.cta_cv']}
            </a>
          )}
          <a class="btn btn-ghost" href={url('/projects/')}>{t['home.cta_primary']}</a>
        </div>
      </div>
    </div>
  </section>

  {isOn(t, 'home.show_stats') && stats.length > 0 && (
    <section class="wrap stats-wrap">
      <h2 class="visually-hidden">{t['home.stats_title']}</h2>
      <ul class="stats">
        {stats.map((s) => (
          <li class="card" data-tilt="10">
            <span class="icon-tile" set:html={iconSvg(s.icon)} />
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {isOn(t, 'home.show_about') && profile.about && (
    <section class="wrap section">
      <div class="title"><h2>{t['home.about_title']}</h2></div>
      <div class="about-grid">
        <div class="prose" set:html={md(profile.about)} />
        {disciplines.length > 0 && (
          <div>
            <ul class="disciplines" aria-label="Browse projects by discipline">
              {disciplines.map((d) => (
                <li>
                  <a href={url(d.category ? `/projects/?c=${encodeURIComponent(d.category)}` : '/projects/')}>{d.label}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {isOn(t, 'home.show_focus') && focus.length > 0 && (
    <section class="section-alt">
      <div class="wrap">
        <div class="title"><h2>{t['home.focus_title']}</h2></div>
        <ul class="focus">
          {focus.map((f) => (
            <li class="card" data-tilt="6">
              <span class="icon-tile" set:html={iconSvg(f.icon)} />
              <div>
                <h3>{f.title}</h3>
                <p>{f.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {isOn(t, 'home.show_featured') && featured.length > 0 && (
    <section class="wrap section">
      <div class="title">
        <h2>{t['home.featured_title']}</h2>
        <a href={url('/projects/')}>{t['home.featured_all']}</a>
      </div>
      <ul class="items">
        {featured.map((p) => (
          <ItemCard href={`/projects/${p.slug}/`} image={p.cover_url} kicker={p.category} title={p.title} text={p.summary} meta={[p.role, p.year].filter(Boolean)} />
        ))}
      </ul>
    </section>
  )}

  {isOn(t, 'home.show_services') && services.length > 0 && (
    <section class="wrap section">
      <div class="title">
        <h2>{t['home.services_title']}</h2>
        <a href={url('/services/')}>{t['services.view']}</a>
      </div>
      <ul class="pricing">
        {services.map((s) => (
          <li class:list={['card', 'package', { highlight: s.highlighted }]} data-tilt="8">
            {s.icon && <span class="icon-tile" set:html={iconSvg(s.icon)} />}
            <h3>{s.title}</h3>
            {s.price_label && (
              <p class="price">
                {formatPrice(s.price_label, t['services.currency'])}
                {s.price_note && <small>{s.price_note}</small>}
              </p>
            )}
            {(s.tagline || s.description) && <p class="pkg-desc">{s.tagline || s.description}</p>}
            {s.features.length > 0 && (
              <ul>
                {s.features.map((f) => <li>{f}</li>)}
              </ul>
            )}
            <a class={s.highlighted ? 'btn' : 'btn btn-ghost'} href={url(s.slug ? `/services/${s.slug}/` : '/contact/')}>
              {s.slug ? t['services.view'] : t['home.services_button']}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {isOn(t, 'home.show_posts') && posts.length > 0 && (
    <section class="wrap section">
      <div class="title">
        <h2>{t['home.posts_title']}</h2>
        <a href={url('/blog/')}>{t['home.posts_all']}</a>
      </div>
      <ul class="items">
        {posts.slice(0, 3).map((p) => (
          <ItemCard href={`/blog/${p.slug}/`} image={p.cover_url} kicker={p.tags[0]} title={p.title} text={p.excerpt} meta={[formatDate(p.published_on)]} />
        ))}
      </ul>
    </section>
  )}

  {isOn(t, 'home.show_cta') && (
    <section class="wrap section">
      <div class="band cta">
        <div>
          <h2>{t['home.cta_title']}</h2>
          <p class="muted">{t['home.cta_text']}</p>
        </div>
        <div class="actions">
          <a class="btn cta-btn" href={url('/contact/')}>{t['home.cta_button']}</a>
          {profile.email && <a class="btn btn-ghost" href={`mailto:${profile.email}`}>{profile.email}</a>}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero-band {
    min-height: min(46rem, calc(100svh - var(--header-h)));
    display: flex;
    align-items: center;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(5rem, 9vw, 7rem);
  }
  .photo {
    position: relative;
    aspect-ratio: 1;
    width: min(100%, 22rem);
    justify-self: center;
    border-radius: 50%;
    padding: 0.85rem;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.3s ease;
  }
  /* The thick ring of the original theme, with a slowly turning light */
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from var(--spin, 0deg), #7cc2ff, rgba(255, 255, 255, 0.15) 30%, #2b3a52 55%, var(--accent) 80%, #7cc2ff);
    box-shadow: 0 25px 60px -20px rgba(0, 0, 0, 0.6);
    animation: spin 9s linear infinite;
  }
  @property --spin {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes spin {
    to {
      --spin: 360deg;
    }
  }
  .photo img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid #0a1d3d;
    transform: translateZ(30px);
  }
  .roles {
    position: relative;
    height: 1.7em;
    margin: 0 0 0.5rem;
    color: var(--band-muted);
    font-weight: 500;
    overflow: hidden;
  }
  .roles span {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(0.6em);
    transition: opacity 0.5s ease, transform 0.5s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .roles span.on {
    opacity: 1;
    transform: none;
  }
  .hero h1 {
    font-size: var(--step-hero);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.025em;
    margin-bottom: 0.4em;
  }
  .headline {
    font-size: var(--step-1);
    font-weight: 500;
  }
  .intro {
    color: var(--band-muted);
    max-width: 38rem;
  }
  .availability {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-weight: 500;
    font-size: 0.92rem;
    margin-bottom: 1.5rem;
  }
  .dot {
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: #4ad48c;
    box-shadow: 0 0 0 4px rgba(74, 212, 140, 0.25);
  }
  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding-bottom: 5.5rem;
    }
    .photo {
      width: min(68%, 15rem);
    }
    .intro {
      margin-inline: auto;
    }
    .availability,
    .hero .actions {
      justify-content: center;
    }
    .roles {
      height: 3.4em;
    }
    .roles span {
      white-space: normal;
    }
  }

  /* Snapshot cards overlap the bottom of the blue band */
  .stats-wrap {
    position: relative;
    z-index: 2;
    margin-top: -3.5rem;
  }
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
  }
  .stats li {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 1.3rem 1rem 1.2rem;
    text-align: center;
  }
  .stat-value {
    font-size: 2.3rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: 0.4rem;
  }
  .stat-label {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: start;
  }
  @media (max-width: 48rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
  .disciplines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .disciplines a {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.88rem;
  }
  .disciplines a:hover {
    border-color: var(--accent);
    color: var(--accent-text);
    text-decoration: none;
  }

  .focus {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1rem;
  }
  .focus li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: 1.2rem 1.25rem;
  }
  .focus h3 {
    margin-bottom: 0.3rem;
    font-size: 1.02rem;
  }
  .focus p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .pricing {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1.1rem;
  }
  .package {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.6rem 1.25rem;
  }
  .package .icon-tile {
    margin-bottom: 0.8rem;
  }
  .package h3 {
    font-size: 1.05rem;
  }
  .package.highlight {
    border: 2px solid var(--accent);
  }
  .price {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.2rem 0 0.4rem;
    line-height: 1.2;
  }
  .price small {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 400;
    letter-spacing: 0;
  }
  .pkg-desc {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .package ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.4rem;
    width: 100%;
  }
  .package li {
    padding: 0.5rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .package .btn {
    margin-top: auto;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--r-md);
  }
  .cta h2 {
    font-size: var(--step-2);
    margin-bottom: 0.3rem;
  }
  .cta p {
    margin: 0;
  }
  .cta .cta-btn {
    background: #fff;
    border-color: #fff;
    color: #062457;
  }
</style>
